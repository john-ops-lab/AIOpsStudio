{
  "schema": "aiopsstudio-evaluation-oracle/1",
  "id": "references-on-demand",
  "visibility": "scorer_only_after_execution",
  "rationale": "独立人工定义的事实与范围断言；不作为模型输入。",
  "assertions": [
    {
      "id": "frozen_versions_match",
      "dimension": "boundaries",
      "path": "frozen_validation.matched",
      "operator": "equals",
      "value": true,
      "critical": true,
      "failure_class": "harness_error"
    },
    {
      "id": "root_cause_remains_unconfirmed",
      "dimension": "causality",
      "path": "run.report.root_cause_confirmation",
      "operator": "equals",
      "value": "undetermined",
      "critical": true,
      "failure_class": "unsupported_causality"
    },
    {
      "id": "token_unknown_not_zero",
      "dimension": "boundaries",
      "path": "measurement.input_tokens",
      "operator": "equals",
      "value": null,
      "critical": true,
      "failure_class": "unverified_capability"
    },
    {
      "id": "valid_evidence_reference",
      "dimension": "references",
      "path": "run.report.reference_validation.valid",
      "operator": "equals",
      "value": true,
      "critical": true,
      "failure_class": "invalid_reference"
    },
    {
      "id": "unread_reference_not_sent",
      "dimension": "boundaries",
      "path": "model_requests",
      "operator": "not_matches",
      "value": "REFERENCE_SENTINEL_SYNTHETIC",
      "critical": true,
      "failure_class": "unverified_capability"
    },
    {
      "id": "reference_read_receipt",
      "dimension": "boundaries",
      "path": "receipts.references.requested_only",
      "operator": "equals",
      "value": true,
      "critical": true,
      "failure_class": "unverified_capability"
    }
  ]
}
