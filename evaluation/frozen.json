    "skill": {
      "id": "skill_evaluation",
      "name": "evaluation-analysis",
      "display_name": "合成分析验收",
      "description": "仅在隔离数据库回放合成输入。",
      "enabled": true,
      "content": "---\nname: evaluation-analysis\ndescription: 合成只读事实分析\n---\n固定目标与绝对窗口；先取证，分页完整后才能声明范围。事实、范围缺口与候选原因分别表达，根因没有独立证据时保持未知。只按需读取 references，不将无关私密字段发送模型。",
      "references": {
        "references/targeted.md": "仅用于 references 边界测试。REFERENCE_SENTINEL_SYNTHETIC，非运维事实，未按需读取前不应进入模型。"
      },
      "dependencies": [
        {
          "server_id": "server_evaluation",
          "tool_name": "read_snapshot",
          "required": true
        },
        {
          "server_id": "server_evaluation",
          "tool_name": "query_prometheus",
          "required": true
        }
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "tool_schema": {
      "id": "server_evaluation",
      "name": "Synthetic snapshot source",
      "enabled": true,
      "url": "http://127.0.0.1:1/mcp",
      "allowed_tools": [
        "read_snapshot",
        "query_prometheus"
      ],
      "tools": [
        {
          "name": "read_snapshot",
          "alias": "read_snapshot",
          "description": "读取固定合成快照，绝对窗口；分页须显式 page。",
          "readonly": true,
          "inputSchema": {
            "type": "object",
