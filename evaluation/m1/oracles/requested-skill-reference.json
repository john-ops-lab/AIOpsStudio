{
  "schema": "aiopsstudio-evaluation-oracle/1",
  "id": "requested-skill-reference",
  "visibility": "scorer_only_after_execution",
  "rationale": "实际固定版本Skill资料按需补读，资料不能成为源事实。",
  "assertions": [
    {
      "id": "frozen_versions_match",
      "dimension": "boundaries",
      "path": "frozen_validation.matched",
      "operator": "equals",
      "value": true,
      "critical": true,
      "failure_class": "harness_error"
    },
    {
      "id": "requested_reference_actually_read",
      "dimension": "boundaries",
      "path": "receipts.references.model_reads",
      "operator": "at_least",
      "value": 1,
      "critical": true,
      "failure_class": "unverified_capability"
    },
    {
      "id": "reference_only_after_read",
      "dimension": "boundaries",
      "path": "receipts.references.requested_only",
      "operator": "equals",
      "value": true,
      "critical": true,
      "failure_class": "privacy_violation"
    },
    {
      "id": "reference_content_delivered",
      "dimension": "omissions",
      "path": "model_requests",
      "operator": "matches",
      "value": "REFERENCE_SENTINEL_SYNTHETIC",
      "critical": true,
      "failure_class": "omission"
    },
    {
      "id": "reference_is_not_source_fact",
      "dimension": "facts",
      "path": "run.report.grounding.facts",
      "operator": "not_matches",
      "value": "REFERENCE_SENTINEL_SYNTHETIC",
      "critical": true,
      "failure_class": "factual_error"
    },
    {
      "id": "source_fact_still_present",
      "dimension": "facts",
      "path": "run.report.analysis",
      "operator": "matches",
      "value": "error_rate.*0\\.18",
      "critical": true,
      "failure_class": "factual_error"
    },
    {
      "id": "cite_actual_source",
      "dimension": "references",
      "path": "run.report",
      "operator": "citation_source",
      "value": "read_snapshot",
      "critical": true,
      "failure_class": "invalid_reference"
    }
  ]
}
